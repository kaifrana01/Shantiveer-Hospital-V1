# =========================
# ShantiVeer HMS environment
# =========================
#
# IMPORTANT:
# This project requires PostgreSQL via DATABASE_URL.
# SQLite has been removed from the app.
#
# Create a local file:
#   copy .env.example .env
# Then edit values below.

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True

# Security / CSRF
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Database (Neon)
# Example:
# DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Cache (optional)
# Recommended for Vercel/production; for local dev you can omit.
# Example:
# REDIS_URL=rediss://user:pass@host:port/db
REDIS_URL=

# Email (optional)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# Hospital info (optional)
HOSPITAL_NAME=ShantiVeer Hospital
HOSPITAL_ADDRESS=Main Road, City
HOSPITAL_PHONE=9876543210

# Deployed on Vercel
VERCEL=1

