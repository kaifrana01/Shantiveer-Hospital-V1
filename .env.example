# =============================================================================
# ShantiVeer HMS — Environment Configuration
# =============================================================================
#
# SETUP:
#   copy .env.example .env
#   Then fill in the values below.
#
# REQUIRED fields are marked [REQUIRED].
# =============================================================================

# ─── Django ───────────────────────────────────────────────────────────────────
# [REQUIRED] Generate with:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string-at-least-50-chars

# Set to True only for local development. Always False in production.
DJANGO_DEBUG=False

# ─── Security / Hosts ─────────────────────────────────────────────────────────
# Comma-separated list of allowed host names.
ALLOWED_HOSTS=shantiveerhospital.in,www.shantiveerhospital.in

# Comma-separated list of trusted origins for CSRF (include https:// prefix).
CSRF_TRUSTED_ORIGINS=https://shantiveerhospital.in,https://www.shantiveerhospital.in

# Set to False when behind Nginx (Nginx handles SSL termination).
SECURE_SSL_REDIRECT=False

# ─── Database — MySQL (Hostinger / Aiven) ────────────────────────────────────
# [REQUIRED] MySQL connection details.
MYSQL_NAME=shantiveer_hms
MYSQL_USER=your_db_user
MYSQL_PASSWORD=your_db_password
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# Leave blank — using MySQL, not PostgreSQL.
DATABASE_URL=

# ─── Cache ────────────────────────────────────────────────────────────────────
# [Optional] Redis URL for brute-force login protection.
# Leave blank to use in-memory cache.
REDIS_URL=

# ─── Email — Hostinger SMTP ───────────────────────────────────────────────────
# [REQUIRED for password reset] Hostinger business email SMTP settings.
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=noreply@shantiveerhospital.in
EMAIL_HOST_PASSWORD=your_email_password
DEFAULT_FROM_EMAIL=ShantiVeer Hospital <noreply@shantiveerhospital.in>

# ─── Login Security ───────────────────────────────────────────────────────────
# Max failed login attempts before IP lockout
LOGIN_ATTEMPTS_LIMIT=5
# Lockout duration in seconds (300 = 5 minutes)
LOGIN_LOCKOUT_DURATION=300

# ─── Hospital Info ────────────────────────────────────────────────────────────
HOSPITAL_NAME=ShantiVeer Hospital
HOSPITAL_ADDRESS=Charthwal Main Road, Thana Bhawan
HOSPITAL_PHONE=9876543210
HOSPITAL_UPI_ID=

# ─── Demo Setup ───────────────────────────────────────────────────────────────
# NEVER set to true in production.
ALLOW_DEMO_SETUP=false
